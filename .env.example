# ==============================================================================
# Folio — Environment Variables (Phases 1–3)
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any real secret values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Phase 1: Database (Turso / libSQL)
# Use `file:local.db` for zero-config local SQLite development.
# In production, point to `libsql://<db>-<org>.turso.io` and set TURSO_AUTH_TOKEN.
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# Phase 1: Authentication (Better Auth — Email/Password + Google OAuth)
# Generate BETTER_AUTH_SECRET with: `openssl rand -base64 32`
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-at-least-32-character-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Phase 1–2: Transactional Email (Resend)
# Leave RESEND_API_KEY blank in local dev to use the non-sensitive console dispatcher.
# Optional EMAIL_FROM defaults to `Folio <onboarding@resend.dev>` until you verify a domain.
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""

# ------------------------------------------------------------------------------
# Phase 2: Durable Background Workflows & Timed Reminders (Inngest)
# In local dev, set INNGEST_DEV="1" and run `pnpm dlx inngest-cli@latest dev`
# (no cloud event/signing keys required locally).
# ------------------------------------------------------------------------------
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ------------------------------------------------------------------------------
# Phase 2–3: Rate Limiting & Permission Cache (Local Redis / Upstash Redis)
# Locally, point REDIS_URL to your passwordless Redis instance.
# In production, set UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# Phase 2: Web Push Notifications (VAPID — 100% local ECDSA P-256 keys, no cloud required)
# Generate keys locally with: `pnpm dlx web-push generate-vapid-keys`
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@example.com"
